<!-- Select the Program Files directory for the installer architecture. -->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<!-- ARM64 packages require Windows Installer 5.0. Other architectures keep 4.5. -->
<?if $(sys.BUILDARCH) = arm64 ?>
    <?define PackageInstallerVersion = "500" ?>
<?else ?>
    <?define PackageInstallerVersion = "450" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='tasty'
        UpgradeCode='722A590A-68BF-43EF-9743-EF276DA349FC'
        Manufacturer='zilhak'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Cross-platform GPU-accelerated terminal emulator for AI coding agents'
            Manufacturer='zilhak'
            InstallerVersion='$(var.PackageInstallerVersion)'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='tasty Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='tasty'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='wix\License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <!-- Install LICENSE, THIRD_PARTY_LICENSES.md and every LICENSES file.
                         build-windows.ps1 checks the explicit WiX file list. -->
                    <Component Id='NoticeLicense' Guid='*'>
                        <File Id='NoticeLicenseFile' Name='LICENSE' DiskId='1' Source='LICENSE' KeyPath='yes'/>
                    </Component>
                    <Component Id='NoticeInventory' Guid='*'>
                        <File Id='NoticeInventoryFile' Name='THIRD_PARTY_LICENSES.md' DiskId='1' Source='THIRD_PARTY_LICENSES.md' KeyPath='yes'/>
                    </Component>
                    <Directory Id='NoticeLicensesDir' Name='LICENSES'>
                        <Component Id='NoticeD2Coding' Guid='*'>
                            <File Id='NoticeD2CodingFile' Name='D2Coding-OFL.txt' DiskId='1' Source='LICENSES\D2Coding-OFL.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeKaTeX' Guid='*'>
                            <File Id='NoticeKaTeXFile' Name='KaTeX-MIT.txt' DiskId='1' Source='LICENSES\KaTeX-MIT.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeHighlightjs' Guid='*'>
                            <File Id='NoticeHighlightjsFile' Name='highlightjs-BSD-3-Clause.txt' DiskId='1' Source='LICENSES\highlightjs-BSD-3-Clause.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeMermaid' Guid='*'>
                            <File Id='NoticeMermaidFile' Name='mermaid-MIT.txt' DiskId='1' Source='LICENSES\mermaid-MIT.txt' KeyPath='yes'/>
                        </Component>
                    </Directory>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='92FAADF2-F0AE-4955-8EDB-24566C2FDC56' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='tasty.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\tasty.exe'
                                KeyPath='yes'/>
                        </Component>

                        <!-- Install plugins under bin/plugins/<id> for bundle_root().
                             Keep this list aligned with BUILTINS and build-windows.ps1. -->
                        <Directory Id='PluginsDir' Name='plugins'>
                            <Directory Id='PluginClaudeDir' Name='com.tasty.claude'>
                                <Component Id='PluginClaudeBin' Guid='*'>
                                    <File Id='PluginClaudeBinFile' Source='$(var.CargoTargetBinDir)\tasty-plugin-claude.exe' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginClaudeManifest' Guid='*'>
                                    <File Id='PluginClaudeManifestFile' Source='crates\tasty-plugin-claude\tasty-plugin.toml' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginClaudeSig' Guid='*'>
                                    <File Id='PluginClaudeSigFile' Source='crates\tasty-plugin-claude\tasty-plugin.toml.sig' KeyPath='yes'/>
                                </Component>
                                <Directory Id='PluginClaudeLangDir' Name='lang'>
                                    <Component Id='PluginClaudeLangEn' Guid='*'>
                                        <File Id='PluginClaudeLangEnFile' Source='crates\tasty-plugin-claude\lang\en.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginClaudeLangJa' Guid='*'>
                                        <File Id='PluginClaudeLangJaFile' Source='crates\tasty-plugin-claude\lang\ja.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginClaudeLangKo' Guid='*'>
                                        <File Id='PluginClaudeLangKoFile' Source='crates\tasty-plugin-claude\lang\ko.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginClaudeLangZhHans' Guid='*'>
                                        <File Id='PluginClaudeLangZhHansFile' Source='crates\tasty-plugin-claude\lang\zh-Hans.toml' KeyPath='yes'/>
                                    </Component>
                                </Directory>
                            </Directory>
                            <Directory Id='PluginClipboardViewerDir' Name='com.tasty.clipboard-viewer'>
                                <Component Id='PluginClipboardViewerBin' Guid='*'>
                                    <File Id='PluginClipboardViewerBinFile' Source='$(var.CargoTargetBinDir)\tasty-plugin-clipboard-viewer.exe' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginClipboardViewerManifest' Guid='*'>
                                    <File Id='PluginClipboardViewerManifestFile' Source='crates\tasty-plugin-clipboard-viewer\tasty-plugin.toml' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginClipboardViewerSig' Guid='*'>
                                    <File Id='PluginClipboardViewerSigFile' Source='crates\tasty-plugin-clipboard-viewer\tasty-plugin.toml.sig' KeyPath='yes'/>
                                </Component>
                                <Directory Id='PluginClipboardViewerLangDir' Name='lang'>
                                    <Component Id='PluginClipboardViewerLangEn' Guid='*'>
                                        <File Id='PluginClipboardViewerLangEnFile' Source='crates\tasty-plugin-clipboard-viewer\lang\en.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginClipboardViewerLangJa' Guid='*'>
                                        <File Id='PluginClipboardViewerLangJaFile' Source='crates\tasty-plugin-clipboard-viewer\lang\ja.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginClipboardViewerLangKo' Guid='*'>
                                        <File Id='PluginClipboardViewerLangKoFile' Source='crates\tasty-plugin-clipboard-viewer\lang\ko.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginClipboardViewerLangZhHans' Guid='*'>
                                        <File Id='PluginClipboardViewerLangZhHansFile' Source='crates\tasty-plugin-clipboard-viewer\lang\zh-Hans.toml' KeyPath='yes'/>
                                    </Component>
                                </Directory>
                            </Directory>
                            <Directory Id='PluginCodexDir' Name='com.tasty.codex'>
                                <Component Id='PluginCodexBin' Guid='*'>
                                    <File Id='PluginCodexBinFile' Source='$(var.CargoTargetBinDir)\tasty-plugin-codex.exe' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginCodexManifest' Guid='*'>
                                    <File Id='PluginCodexManifestFile' Source='crates\tasty-plugin-codex\tasty-plugin.toml' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginCodexSig' Guid='*'>
                                    <File Id='PluginCodexSigFile' Source='crates\tasty-plugin-codex\tasty-plugin.toml.sig' KeyPath='yes'/>
                                </Component>
                                <Directory Id='PluginCodexLangDir' Name='lang'>
                                    <Component Id='PluginCodexLangEn' Guid='*'>
                                        <File Id='PluginCodexLangEnFile' Source='crates\tasty-plugin-codex\lang\en.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginCodexLangJa' Guid='*'>
                                        <File Id='PluginCodexLangJaFile' Source='crates\tasty-plugin-codex\lang\ja.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginCodexLangKo' Guid='*'>
                                        <File Id='PluginCodexLangKoFile' Source='crates\tasty-plugin-codex\lang\ko.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginCodexLangZhHans' Guid='*'>
                                        <File Id='PluginCodexLangZhHansFile' Source='crates\tasty-plugin-codex\lang\zh-Hans.toml' KeyPath='yes'/>
                                    </Component>
                                </Directory>
                            </Directory>
                            <Directory Id='PluginGitViewerDir' Name='com.tasty.git-viewer'>
                                <Component Id='PluginGitViewerBin' Guid='*'>
                                    <File Id='PluginGitViewerBinFile' Source='$(var.CargoTargetBinDir)\tasty-plugin-git-viewer.exe' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginGitViewerManifest' Guid='*'>
                                    <File Id='PluginGitViewerManifestFile' Source='crates\tasty-plugin-git-viewer\tasty-plugin.toml' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginGitViewerSig' Guid='*'>
                                    <File Id='PluginGitViewerSigFile' Source='crates\tasty-plugin-git-viewer\tasty-plugin.toml.sig' KeyPath='yes'/>
                                </Component>
                                <Directory Id='PluginGitViewerLangDir' Name='lang'>
                                    <Component Id='PluginGitViewerLangEn' Guid='*'>
                                        <File Id='PluginGitViewerLangEnFile' Source='crates\tasty-plugin-git-viewer\lang\en.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginGitViewerLangJa' Guid='*'>
                                        <File Id='PluginGitViewerLangJaFile' Source='crates\tasty-plugin-git-viewer\lang\ja.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginGitViewerLangKo' Guid='*'>
                                        <File Id='PluginGitViewerLangKoFile' Source='crates\tasty-plugin-git-viewer\lang\ko.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginGitViewerLangZhHans' Guid='*'>
                                        <File Id='PluginGitViewerLangZhHansFile' Source='crates\tasty-plugin-git-viewer\lang\zh-Hans.toml' KeyPath='yes'/>
                                    </Component>
                                </Directory>
                            </Directory>
                            <Directory Id='PluginHtmlDir' Name='com.tasty.html'>
                                <Component Id='PluginHtmlBin' Guid='*'>
                                    <File Id='PluginHtmlBinFile' Source='$(var.CargoTargetBinDir)\tasty-plugin-html.exe' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginHtmlManifest' Guid='*'>
                                    <File Id='PluginHtmlManifestFile' Source='crates\tasty-plugin-html\tasty-plugin.toml' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginHtmlSig' Guid='*'>
                                    <File Id='PluginHtmlSigFile' Source='crates\tasty-plugin-html\tasty-plugin.toml.sig' KeyPath='yes'/>
                                </Component>
                                <Directory Id='PluginHtmlLangDir' Name='lang'>
                                    <Component Id='PluginHtmlLangEn' Guid='*'>
                                        <File Id='PluginHtmlLangEnFile' Source='crates\tasty-plugin-html\lang\en.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginHtmlLangJa' Guid='*'>
                                        <File Id='PluginHtmlLangJaFile' Source='crates\tasty-plugin-html\lang\ja.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginHtmlLangKo' Guid='*'>
                                        <File Id='PluginHtmlLangKoFile' Source='crates\tasty-plugin-html\lang\ko.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginHtmlLangZhHans' Guid='*'>
                                        <File Id='PluginHtmlLangZhHansFile' Source='crates\tasty-plugin-html\lang\zh-Hans.toml' KeyPath='yes'/>
                                    </Component>
                                </Directory>
                            </Directory>
                            <Directory Id='PluginImageDir' Name='com.tasty.image'>
                                <Component Id='PluginImageBin' Guid='*'>
                                    <File Id='PluginImageBinFile' Source='$(var.CargoTargetBinDir)\tasty-plugin-image.exe' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginImageManifest' Guid='*'>
                                    <File Id='PluginImageManifestFile' Source='crates\tasty-plugin-image\tasty-plugin.toml' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginImageSig' Guid='*'>
                                    <File Id='PluginImageSigFile' Source='crates\tasty-plugin-image\tasty-plugin.toml.sig' KeyPath='yes'/>
                                </Component>
                                <Directory Id='PluginImageLangDir' Name='lang'>
                                    <Component Id='PluginImageLangEn' Guid='*'>
                                        <File Id='PluginImageLangEnFile' Source='crates\tasty-plugin-image\lang\en.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginImageLangJa' Guid='*'>
                                        <File Id='PluginImageLangJaFile' Source='crates\tasty-plugin-image\lang\ja.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginImageLangKo' Guid='*'>
                                        <File Id='PluginImageLangKoFile' Source='crates\tasty-plugin-image\lang\ko.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginImageLangZhHans' Guid='*'>
                                        <File Id='PluginImageLangZhHansFile' Source='crates\tasty-plugin-image\lang\zh-Hans.toml' KeyPath='yes'/>
                                    </Component>
                                </Directory>
                            </Directory>
                            <Directory Id='PluginMarkdownDir' Name='com.tasty.markdown'>
                                <Component Id='PluginMarkdownBin' Guid='*'>
                                    <File Id='PluginMarkdownBinFile' Source='$(var.CargoTargetBinDir)\tasty-plugin-markdown.exe' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginMarkdownManifest' Guid='*'>
                                    <File Id='PluginMarkdownManifestFile' Source='crates\tasty-plugin-markdown\tasty-plugin.toml' KeyPath='yes'/>
                                </Component>
                                <Component Id='PluginMarkdownSig' Guid='*'>
                                    <File Id='PluginMarkdownSigFile' Source='crates\tasty-plugin-markdown\tasty-plugin.toml.sig' KeyPath='yes'/>
                                </Component>
                                <Directory Id='PluginMarkdownLangDir' Name='lang'>
                                    <Component Id='PluginMarkdownLangEn' Guid='*'>
                                        <File Id='PluginMarkdownLangEnFile' Source='crates\tasty-plugin-markdown\lang\en.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginMarkdownLangJa' Guid='*'>
                                        <File Id='PluginMarkdownLangJaFile' Source='crates\tasty-plugin-markdown\lang\ja.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginMarkdownLangKo' Guid='*'>
                                        <File Id='PluginMarkdownLangKoFile' Source='crates\tasty-plugin-markdown\lang\ko.toml' KeyPath='yes'/>
                                    </Component>
                                    <Component Id='PluginMarkdownLangZhHans' Guid='*'>
                                        <File Id='PluginMarkdownLangZhHansFile' Source='crates\tasty-plugin-markdown\lang\zh-Hans.toml' KeyPath='yes'/>
                                    </Component>
                                </Directory>
                            </Directory>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>


            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Tasty'>
                    <Component Id='ApplicationShortcut' Guid='B6F8E2D3-4A1C-4E5F-9C2A-1D3E5F7A9B0C'>
                        <Shortcut Id='ApplicationStartMenuShortcut'
                            Name='Tasty'
                            Description='Cross-platform GPU-accelerated terminal emulator'
                            Target='[Bin]tasty.exe'
                            WorkingDirectory='Bin'
                            Icon='ProductIcon.ico'/>
                        <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU'
                            Key='Software\zilhak\Tasty'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='License'/>
            <!-- Notice set - keep aligned with the NoticeLicensesDir tree above. -->
            <ComponentRef Id='NoticeLicense'/>
            <ComponentRef Id='NoticeInventory'/>
            <ComponentRef Id='NoticeD2Coding'/>
            <ComponentRef Id='NoticeKaTeX'/>
            <ComponentRef Id='NoticeHighlightjs'/>
            <ComponentRef Id='NoticeMermaid'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ApplicationShortcut'/>

            <!-- Builtin plugin components — keep order/list aligned with the
                 Directory tree above and BUILTINS in tasty-host-plugin. -->
            <ComponentRef Id='PluginClaudeBin'/>
            <ComponentRef Id='PluginClaudeManifest'/>
            <ComponentRef Id='PluginClaudeSig'/>
            <ComponentRef Id='PluginClaudeLangEn'/>
            <ComponentRef Id='PluginClaudeLangJa'/>
            <ComponentRef Id='PluginClaudeLangKo'/>
            <ComponentRef Id='PluginClaudeLangZhHans'/>
            <ComponentRef Id='PluginClipboardViewerBin'/>
            <ComponentRef Id='PluginClipboardViewerManifest'/>
            <ComponentRef Id='PluginClipboardViewerSig'/>
            <ComponentRef Id='PluginClipboardViewerLangEn'/>
            <ComponentRef Id='PluginClipboardViewerLangJa'/>
            <ComponentRef Id='PluginClipboardViewerLangKo'/>
            <ComponentRef Id='PluginClipboardViewerLangZhHans'/>
            <ComponentRef Id='PluginCodexBin'/>
            <ComponentRef Id='PluginCodexManifest'/>
            <ComponentRef Id='PluginCodexSig'/>
            <ComponentRef Id='PluginCodexLangEn'/>
            <ComponentRef Id='PluginCodexLangJa'/>
            <ComponentRef Id='PluginCodexLangKo'/>
            <ComponentRef Id='PluginCodexLangZhHans'/>
            <ComponentRef Id='PluginGitViewerBin'/>
            <ComponentRef Id='PluginGitViewerManifest'/>
            <ComponentRef Id='PluginGitViewerSig'/>
            <ComponentRef Id='PluginGitViewerLangEn'/>
            <ComponentRef Id='PluginGitViewerLangJa'/>
            <ComponentRef Id='PluginGitViewerLangKo'/>
            <ComponentRef Id='PluginGitViewerLangZhHans'/>
            <ComponentRef Id='PluginHtmlBin'/>
            <ComponentRef Id='PluginHtmlManifest'/>
            <ComponentRef Id='PluginHtmlSig'/>
            <ComponentRef Id='PluginHtmlLangEn'/>
            <ComponentRef Id='PluginHtmlLangJa'/>
            <ComponentRef Id='PluginHtmlLangKo'/>
            <ComponentRef Id='PluginHtmlLangZhHans'/>
            <ComponentRef Id='PluginImageBin'/>
            <ComponentRef Id='PluginImageManifest'/>
            <ComponentRef Id='PluginImageSig'/>
            <ComponentRef Id='PluginImageLangEn'/>
            <ComponentRef Id='PluginImageLangJa'/>
            <ComponentRef Id='PluginImageLangKo'/>
            <ComponentRef Id='PluginImageLangZhHans'/>
            <ComponentRef Id='PluginMarkdownBin'/>
            <ComponentRef Id='PluginMarkdownManifest'/>
            <ComponentRef Id='PluginMarkdownSig'/>
            <ComponentRef Id='PluginMarkdownLangEn'/>
            <ComponentRef Id='PluginMarkdownLangJa'/>
            <ComponentRef Id='PluginMarkdownLangKo'/>
            <ComponentRef Id='PluginMarkdownLangZhHans'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- On a full uninstall, try to remove the invoking user's runtime-created
             %USERPROFILE%\.tasty directory. The MSI file list does not include it.
             Use the invoking user's token; ignore removal failures such as locked files.
             Skip partial removals and upgrades so they preserve user data. -->
        <CustomAction Id='PurgeTastyUserData'
            Directory='APPLICATIONFOLDER'
            ExeCommand='cmd.exe /c rmdir /s /q "%USERPROFILE%\.tasty"'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore'/>

        <InstallExecuteSequence>
            <Custom Action='PurgeTastyUserData' Before='RemoveFiles'>REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
        </InstallExecuteSequence>


        <Icon Id='ProductIcon.ico' SourceFile='assets\icons\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductIcon.ico' />

        <Property Id='ARPHELPLINK' Value='https://github.com/zilhak/tasty'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>




        </UI>


        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>









    </Product>

</Wix>
