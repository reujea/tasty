<!-- Select the Program Files directory for the installer architecture. -->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<!-- ARM64 packages require Windows Installer 5.0. Other architectures keep 4.5. -->
<?if $(sys.BUILDARCH) = arm64 ?>
    <?define PackageInstallerVersion = "500" ?>
<?else ?>
    <?define PackageInstallerVersion = "450" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='tasty'
        UpgradeCode='722A590A-68BF-43EF-9743-EF276DA349FC'
        Manufacturer='zilhak'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Cross-platform GPU-accelerated terminal emulator for AI coding agents'
            Manufacturer='zilhak'
            InstallerVersion='$(var.PackageInstallerVersion)'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='tasty Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='tasty'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='wix\License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <!-- Install LICENSE, THIRD_PARTY_LICENSES.md and every LICENSES file.
                         build-windows.ps1 checks the explicit WiX file list. -->
                    <Component Id='NoticeLicense' Guid='*'>
                        <File Id='NoticeLicenseFile' Name='LICENSE' DiskId='1' Source='LICENSE' KeyPath='yes'/>
                    </Component>
                    <Component Id='NoticeInventory' Guid='*'>
                        <File Id='NoticeInventoryFile' Name='THIRD_PARTY_LICENSES.md' DiskId='1' Source='THIRD_PARTY_LICENSES.md' KeyPath='yes'/>
                    </Component>
                    <Directory Id='NoticeLicensesDir' Name='LICENSES'>
                        <Component Id='NoticeD2Coding' Guid='*'>
                            <File Id='NoticeD2CodingFile' Name='D2Coding-OFL.txt' DiskId='1' Source='LICENSES\D2Coding-OFL.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeKaTeX' Guid='*'>
                            <File Id='NoticeKaTeXFile' Name='KaTeX-MIT.txt' DiskId='1' Source='LICENSES\KaTeX-MIT.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeHighlightjs' Guid='*'>
                            <File Id='NoticeHighlightjsFile' Name='highlightjs-BSD-3-Clause.txt' DiskId='1' Source='LICENSES\highlightjs-BSD-3-Clause.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeMermaid' Guid='*'>
                            <File Id='NoticeMermaidFile' Name='mermaid-MIT.txt' DiskId='1' Source='LICENSES\mermaid-MIT.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeHack' Guid='*'>
                            <File Id='NoticeHackFile' Name='Hack-MIT-Bitstream-Vera.txt' DiskId='1' Source='LICENSES\Hack-MIT-Bitstream-Vera.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeNotoEmoji' Guid='*'>
                            <File Id='NoticeNotoEmojiFile' Name='NotoEmoji-OFL-1.1.txt' DiskId='1' Source='LICENSES\NotoEmoji-OFL-1.1.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeUbuntu' Guid='*'>
                            <File Id='NoticeUbuntuFile' Name='Ubuntu-Ubuntu-font-1.0.txt' DiskId='1' Source='LICENSES\Ubuntu-Ubuntu-font-1.0.txt' KeyPath='yes'/>
                        </Component>
                        <Component Id='NoticeEmojiIcon' Guid='*'>
                            <File Id='NoticeEmojiIconFile' Name='emoji-icon-font-MIT.txt' DiskId='1' Source='LICENSES\emoji-icon-font-MIT.txt' KeyPath='yes'/>
                        </Component>
                    </Directory>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='92FAADF2-F0AE-4955-8EDB-24566C2FDC56' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='tasty.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\tasty.exe'
                                KeyPath='yes'/>
                        </Component>

                        <!-- Install plugins under bin/plugins/<id> for bundle_root().
                             build-windows.ps1 generates target\bundled-plugins.wxs from the received
                             official plugin folders; it fills this directory and defines the
                             BundledPlugins component group referenced by the Binaries feature. -->
                        <Directory Id='PluginsDir' Name='plugins'/>
                    </Directory>
                </Directory>
            </Directory>


            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Tasty'>
                    <Component Id='ApplicationShortcut' Guid='B6F8E2D3-4A1C-4E5F-9C2A-1D3E5F7A9B0C'>
                        <Shortcut Id='ApplicationStartMenuShortcut'
                            Name='Tasty'
                            Description='Cross-platform GPU-accelerated terminal emulator'
                            Target='[Bin]tasty.exe'
                            WorkingDirectory='Bin'
                            Icon='ProductIcon.ico'/>
                        <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU'
                            Key='Software\zilhak\Tasty'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='License'/>
            <!-- Notice set - keep aligned with the NoticeLicensesDir tree above. -->
            <ComponentRef Id='NoticeLicense'/>
            <ComponentRef Id='NoticeInventory'/>
            <ComponentRef Id='NoticeD2Coding'/>
            <ComponentRef Id='NoticeKaTeX'/>
            <ComponentRef Id='NoticeHighlightjs'/>
            <ComponentRef Id='NoticeMermaid'/>
            <ComponentRef Id='NoticeHack'/>
            <ComponentRef Id='NoticeNotoEmoji'/>
            <ComponentRef Id='NoticeUbuntu'/>
            <ComponentRef Id='NoticeEmojiIcon'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ApplicationShortcut'/>

            <!-- Bundled plugin files come from the generated target\bundled-plugins.wxs. -->
            <ComponentGroupRef Id='BundledPlugins'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- Only the removal dialog can ask for %USERPROFILE%\.tasty to be deleted, and the MSI file
             list does not include that folder. The action runs in the client UI sequence after
             ExecuteAction, so silent and basic-UI removals never reach it, a failed or cancelled
             removal never deletes data, and it runs as the user who started the removal.
             TastyRemoveUserData is private so a command line cannot set it. The condition reads
             WixUI_InstallMode because the Remove control event sets REMOVE only for the server
             side, so REMOVE is empty here after the wizard. A file that cannot be
             deleted does not fail the removal; the user is told that the folder remains. -->
        <Property Id='TastyRemoveUserDataCommand' Value='cmd.exe /c rmdir /s /q "%USERPROFILE%\.tasty" &amp; if exist "%USERPROFILE%\.tasty" powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command "(New-Object -ComObject WScript.Shell).Popup(&apos;Tasty was uninstalled, but some data remains in the .tasty folder in your Windows user folder. Close Tasty if it is still running, then delete that folder manually.&apos;,0,&apos;Tasty data deletion incomplete&apos;,48)"'/>
        <!-- The command lives in a property because the CustomAction target column holds 255 characters. -->
        <CustomAction Id='RemoveTastyUserData'
            Directory='TARGETDIR'
            ExeCommand='[TastyRemoveUserDataCommand]'
            Execute='immediate'
            Return='ignore'/>

        <InstallUISequence>
            <Custom Action='RemoveTastyUserData' After='ExecuteAction'>TastyRemoveUserData="1" AND WixUI_InstallMode="Remove" AND NOT UPGRADINGPRODUCTCODE</Custom>
        </InstallUISequence>


        <Icon Id='ProductIcon.ico' SourceFile='assets\icons\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductIcon.ico' />

        <Property Id='ARPHELPLINK' Value='https://github.com/zilhak/tasty'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>

            <!-- The geometry follows the WixUI dialogs this one sits between. -->
            <Dialog Id='TastyRemoveDataDlg' Width='370' Height='270' Title='!(loc.VerifyReadyDlg_Title)'>
                <Control Id='Back' Type='PushButton' X='180' Y='243' Width='56' Height='17' Text='!(loc.WixUIBack)'>
                    <Condition Action='disable'>Preselected</Condition>
                    <Condition Action='enable'>NOT Preselected</Condition>
                    <Publish Event='NewDialog' Value='MaintenanceTypeDlg'>NOT Preselected</Publish>
                </Control>
                <Control Id='Next' Type='PushButton' X='236' Y='243' Width='56' Height='17' Default='yes' Text='!(loc.WixUINext)'>
                    <Publish Property='WixUI_InstallMode' Value='Remove' Order='1'>1</Publish>
                    <Publish Event='NewDialog' Value='VerifyReadyDlg' Order='2'>1</Publish>
                </Control>
                <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17' Cancel='yes' Text='!(loc.WixUICancel)'>
                    <Publish Event='SpawnDialog' Value='CancelDlg'>1</Publish>
                </Control>
                <Control Id='BannerBitmap' Type='Bitmap' X='0' Y='0' Width='370' Height='44' TabSkip='no' Text='!(loc.VerifyReadyDlgBannerBitmap)'/>
                <Control Id='BannerLine' Type='Line' X='0' Y='44' Width='370' Height='0'/>
                <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0'/>
                <Control Id='Title' Type='Text' X='15' Y='15' Width='300' Height='15' Transparent='yes' NoPrefix='yes' Text='{\WixUI_Font_Title}Uninstall Tasty'/>
                <Control Id='RemoveUserData' Type='CheckBox' X='25' Y='70' Width='320' Height='17' Property='TastyRemoveUserData' CheckBoxValue='1' Text='Permanently delete settings, history, saved logins and profiles in .tasty'/>
                <Control Id='RemoveUserDataDescription' Type='Text' X='37' Y='89' Width='308' Height='56' Text='This includes the entire .tasty folder in your Windows user folder, including themes, layouts, agent memory and plugin copies. Deletion happens only after a successful uninstall. Data stored elsewhere and Tasty hooks are kept.'/>
            </Dialog>

            <!-- A later NewDialog event replaces the WixUI target of the same control. -->
            <Publish Dialog='MaintenanceTypeDlg' Control='RemoveButton' Event='NewDialog' Value='TastyRemoveDataDlg' Order='3'>1</Publish>
            <Publish Dialog='VerifyReadyDlg' Control='Back' Event='NewDialog' Value='TastyRemoveDataDlg' Order='4'>WixUI_InstallMode = "Remove"</Publish>

            <!-- msiexec /x with full UI skips the WixUI maintenance dialogs and would show ResumeDlg. -->
            <InstallUISequence>
                <Show Dialog='ResumeDlg' Before='ProgressDlg'>Installed AND (RESUME OR (Preselected AND NOT REMOVE="ALL"))</Show>
                <Show Dialog='TastyRemoveDataDlg' Before='ProgressDlg'>Installed AND Preselected AND NOT RESUME AND REMOVE="ALL"</Show>
            </InstallUISequence>
        </UI>


        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>









    </Product>

</Wix>
