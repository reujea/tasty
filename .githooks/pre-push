#!/usr/bin/env bash
# push할 커밋의 플러그인 버전을 확인한 뒤 CI의 빠른 스크립트 검사와 빌드·문서·소스 가드를 검사한다.
# 설치: git config core.hooksPath .githooks
# 검사별 실행 방법: docs/dev-guide/git-hooks.md
set -e -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
# Git exports repository-local paths to hooks; do not leak them into synthetic repos.
GIT_LOCAL_ENV_VARS="$(git rev-parse --local-env-vars)"
red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }
yellow() { printf '\033[33m%s\033[0m\n' "$*" >&2; }

FAIL=0
STARTED=$SECONDS
LOG_ROOT="$(git rev-parse --git-path hook-logs)"
mkdir -p "$LOG_ROOT"
LOG_DIR="$(mktemp -d "$LOG_ROOT/pre-push.XXXXXX")"
SUMMARY="$LOG_DIR/summary.log"
printf 'push 전 검사를 시작합니다. 전체 로그: %s\n' "$LOG_DIR"

# 명령의 종료 코드를 직접 확인한다. 출력은 검사별로 저장하고 실패 시 마지막 60줄을 보여 준다.
run_check() {
    local id="$1" title="$2" started=$SECONDS rc=0
    shift 2
    yellow "시작: $title"
    if (
        while IFS= read -r name; do
            [ -z "$name" ] || unset "$name"
        done <<< "$GIT_LOCAL_ENV_VARS"
        cd "$REPO_ROOT" || exit 1
        "$@"
    ) > "$LOG_DIR/$id.log" 2>&1; then
        green "통과: $title ($((SECONDS - started))초)"
        printf '통과: %s (%s초)\n' "$title" "$((SECONDS - started))" >> "$SUMMARY"
    else
        rc=$?
        tail -60 "$LOG_DIR/$id.log" >&2
        red "실패: $title ($((SECONDS - started))초, 종료 코드 $rc). 전체 로그: $LOG_DIR/$id.log"
        printf '실패: %s (%s초)\n' "$title" "$((SECONDS - started))" >> "$SUMMARY"
        FAIL=1
    fi
}

finish() {
    printf '\npush 전 검사 결과 (총 %s초)\n' "$((SECONDS - STARTED))"
    cat "$SUMMARY"
    if [ "$FAIL" -ne 0 ]; then
        red "push를 중단했습니다. 실패한 항목을 수정하고 커밋한 뒤 다시 push해 주세요."
        return 1
    fi
    green "실행한 push 전 검사를 모두 통과했습니다."
}

GIT_NULL_SHA=0000000000000000000000000000000000000000
PUSH_REMOTE="${1:-origin}"
PUSH_REFS=""
PUSH_INVOKED_BY_GIT=0
# Git이 전달하는 ref 목록은 두 검사에서 함께 사용한다. 직접 실행할 때는 stdin을 기다리지 않는다.
if [ "$#" -ge 1 ] && [ ! -t 0 ]; then
    PUSH_INVOKED_BY_GIT=1
    PUSH_REFS="$(cat)"
fi

# ─
# B.9  원격에 게시된 버전과 push할 플러그인 버전 비교
check_published_plugin_version() {
    local considered=0 judged=0 failed=0 rc
    local local_ref local_sha remote_ref remote_sha
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -n "${local_ref:-}" ] || continue
        considered=$((considered + 1))
        if [ "$local_sha" = "$GIT_NULL_SHA" ]; then
            echo "$remote_ref: 삭제할 ref이므로 버전 검사를 생략합니다."
            continue
        fi
        if [ "$remote_sha" = "$GIT_NULL_SHA" ]; then
            echo "$remote_ref: 새 ref이므로 비교할 원격 버전이 없습니다."
            continue
        fi
        if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
            red "$remote_ref: 원격 커밋 ${remote_sha}를 로컬에서 찾을 수 없습니다."
            red "git fetch $PUSH_REMOTE 후 다시 시도해 주세요. 얕은 복제라면 git fetch --unshallow가 필요합니다."
            failed=1
            continue
        fi
        judged=$((judged + 1))
        rc=0
        bash scripts/check-plugin-version-bump.sh --range "$remote_sha" "$local_sha" || rc=$?
        if [ "$rc" -eq 1 ]; then
            red "$remote_ref: 변경된 플러그인의 버전이 원격에 게시된 버전보다 높아야 합니다."
            red "위 목록의 Cargo.toml과 tasty-plugin.toml 버전을 함께 올려 주세요."
            red "cargo check로 Cargo.lock도 갱신하고 세 파일을 함께 커밋해 주세요."
            failed=1
        elif [ "$rc" -ne 0 ]; then
            red "$remote_ref: 버전을 검사하지 못했습니다 (종료 코드 $rc). 위 오류를 확인해 주세요."
            failed=1
        fi
    done <<EOF
$PUSH_REFS
EOF
    echo "ref ${considered}개: 검사 ${judged}개, 생략 $((considered - judged))개"
    return "$failed"
}

if [ "$PUSH_INVOKED_BY_GIT" -eq 1 ]; then
    if [ -z "$PUSH_REFS" ]; then
        green "push할 변경 사항이 없어 검사를 생략합니다."
        exit 0
    fi
    run_check B.9 '플러그인 버전' check_published_plugin_version
    if [ "$FAIL" -ne 0 ]; then
        yellow '커밋 검사에 실패해 빌드 검사는 실행하지 않습니다.'
        finish
        exit 1
    fi
else
    yellow '생략: 플러그인 버전 — 직접 실행했으므로 Git의 원격 ref 정보가 없습니다.'
    yellow '직접 검사: bash scripts/check-plugin-version-bump.sh --range <원격 커밋> HEAD'
    printf '생략: 플러그인 버전 — Git의 ref 정보 없음\n' >> "$SUMMARY"
fi

# ─
# B.11  CI 스크립트 검사가 쓰는 판정기(문자열 마스킹·test 전용 코드 제외) 빌드
run_check B.11 '판정기 빌드' cargo build --locked -p tasty-doc-guards --bin mask-source --bin strip-cfg-test

# ─
# B.12  파일 SLOC 상한 (complexity-check.yml)
run_check B.12 '파일 SLOC' bash scripts/check-file-size.sh

# ─
# B.13  동결 명부 파일의 SLOC 총합 래칫 (complexity-check.yml)
run_check B.13 '동결 총합 래칫' bash scripts/check-frozen-sum-ratchet.sh

# ─
# B.14  Intent를 거치지 않는 상태 변경 (script-gates.yml)
run_check B.14 'Intent 규율' bash scripts/check-intent-discipline.sh

# ─
# B.15  근거 없는 allow 속성 수 래칫 (script-gates.yml)
run_check B.15 '근거 없는 allow 래칫' bash scripts/check-allow-reason.sh

# ─
# B.16  공용 순회를 거치지 않는 read_dir 수 래칫 (script-gates.yml)
run_check B.16 '공용 순회 래칫' bash scripts/check-shared-walk-ratchet.sh

# ─
# B.17  Core::apply 밖의 구조 writer 래칫 (script-gates.yml)
run_check B.17 '구조 writer 래칫' bash scripts/check-core-writer-ratchet.sh

# ─
# B.18  추적 셸 자산 전체의 shellcheck (script-gates.yml)
# 검사 도구는 받지 않는다. 없으면 스크립트가 설치 안내와 함께 종료 코드 2로 실패한다.
run_check B.18 '셸 자산' bash scripts/check-shell-assets.sh

# ─
# B.19  작업 트리 전체의 형식 (format-check.yml). pre-commit A.2는 staged Rust 파일이 있을 때만 돈다.
# workspace에서 제외한 tasty-plugin-sdk-wasm도 검사한다. 앞 검사가 실패해도 뒤 검사를 실행한다.
fmt_check_all() {
    local rc=0
    cargo fmt --check || rc=1
    cargo fmt --check --manifest-path crates/tasty-plugin-sdk-wasm/Cargo.toml || rc=1
    return "$rc"
}
run_check B.19 'cargo fmt --check' fmt_check_all

# ─
# B.4  개발 빌드와 테스트 코드의 컴파일·Clippy 검사: correctness 경고는 오류로 처리
run_check B.4 'cargo clippy --workspace --all-targets -- -D clippy::correctness' cargo clippy --workspace --all-targets -- -D clippy::correctness

# ─
# B.8  release 설정으로 워크스페이스 컴파일
run_check B.8 'cargo check --workspace --release --locked' cargo check --workspace --release --locked

# ─
# B.6  GUI 기능을 제외한 headless 빌드 컴파일
run_check B.6 'cargo check --no-default-features' cargo check --no-default-features

# ─
# B.7  문서, 매니페스트, 인덱스 검사
# design_source_* 시험은 dtcg/SOURCE 커밋의 tasty-page가 필요하다. 넘겨받은 경로가 없으면 받는다.
doc_guards_with_design_source() {
    if [ -z "${TASTY_PAGE_DIR:-}" ]; then
        TASTY_PAGE_DIR="$(bash scripts/fetch-design-source.sh)" || return 1
        export TASTY_PAGE_DIR
    fi
    cargo test -p tasty-doc-guards
}
run_check B.7 'cargo test -p tasty-doc-guards' doc_guards_with_design_source

# ─
# B.10  루트 lib의 소스 가드 실행
# 이름 필터는 부분 일치이고 시험이 0개여도 cargo는 0을 돌려준다. 그래서 모듈 경로로 통과한 시험을 찾는다.
# run_check가 if 안에서 부르므로 set -e가 꺼져 있다. 실패는 직접 돌려준다.
root_lib_source_guards() {
    cargo test --lib --locked --no-fail-fast -- source_guards || return
    if ! grep -Eq '^test source_guards::[^ ]+ \.\.\. ok' "$LOG_DIR/B.10.log"; then
        echo 'source_guards 모듈의 시험이 하나도 통과하지 않았습니다. 필터와 모듈 이름을 확인해 주세요.'
        return 1
    fi
}
run_check B.10 'cargo test --lib --locked --no-fail-fast -- source_guards' root_lib_source_guards

finish
