# ────────────────────────────────────────────────────────────
# C.9  egui::Window 직접 사용 (PopupManager 강제)
# ────────────────────────────────────────────────────────────
# staged diff 의 추가 line 만 검사.
check_egui_window() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        case "$f" in
            src/ui/popup/*) continue ;;
            src/ui/popup_defs.rs) continue ;;
            # 부팅 시점 렌더러 — PopupManager/AppState 가 살아있기 전 단계라
            # egui::Window 를 직접 쓸 수밖에 없다(docs/dev-guide/popup-implementation.md
            # 의 예외 항목). 앱 내부 다이얼로그는 여기 없다.
            src/gfx/gpu/shell_setup.rs) continue ;;
            src/gfx/gpu/boot_error.rs) continue ;;
        esac
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E 'egui::Window::|egui::Window[[:space:]]*<' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.9 egui::Window] $f — PopupManager/PopupDef 시스템 사용 (docs/dev-guide/popup-implementation.md):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# C.11 println! / eprintln! (tracing 강제)
# ────────────────────────────────────────────────────────────
# 정책: staged diff 의 추가 라인만 검사 (changed-only).
# 예외 path — *CLI 응답 출력* 은 println 정당:
#   - src/main.rs                     : boot 진입점
#   - src/boot/cli_routing.rs         : clap 라우팅 (잠재적 println)
#   - crates/tasty-cli/*              : CLI 응답 출력 (tree, JSON, 에러 메시지 등
#                                       — caller 가 stdout/stderr 로 수신)
#   - crates/tasty-tui-simulator/*    : 테스트용 TUI simulator
#   - site/*                          : GitHub Pages 정적 사이트 생성기 (workspace
#                                       exclude 된 CLI 빌드 도구 — 생성 로그·경고를
#                                       stdout/stderr 로 내는 것이 정확한 동작)
#   - **/build.rs                     : cargo build script — `cargo:warning=` /
#                                       `cargo:rerun-if-changed=` 같은 directive 가
#                                       println 으로만 가능 (build.rs 에선 tracing
#                                       사용 불가)
#   - crates/tasty-latency-control/*  : 지연 단정의 대조군(ADR-0181). 이 크레이트가 값을 내는
#                                       자리는 **패닉 되감기 중**이고, 그 값을 남기는 것이
#                                       크레이트의 존재 이유다. `spawn_diag` 의 우회로
#                                       (`tracing` + `with_test_writer`)는 여기 못 쓴다 —
#                                       subscriber 를 안 깐 바이너리(본체 bin 의 unit test 등)
#                                       에서 조용히 사라지고, 그 조용한 소실이 정확히 이
#                                       크레이트가 막으려는 실패다. `eprintln!` 은 libtest 가
#                                       설정 없이 포획해 실패한 테스트의 출력 블록에 싣는다.
#   - src/source_guards/*             : 이 디렉토리 전체가 `#[cfg(test)] mod source_guards;`
#                                       뒤에 있어 **출하 바이너리에 없다** — 라이브러리가
#                                       출력하지 않는다는 이 규칙의 대상이 아니다. 여기서
#                                       찍는 것은 가드가 **초록일 때 무엇을 집었는지**이고
#                                       (`-- --nocapture`), 그것이 없으면 양성 대조가
#                                       "통과했다" 만 남기고 무엇을 통과시켰는지는 안 남긴다.
#                                       `tracing` 은 여기서 못 쓴다 — bin 의 유닛 테스트에는
#                                       subscriber 가 없어 조용히 사라지고, 그 조용한 소실이
#                                       정확히 막으려는 것이다(latency-control 예외와 같은 사유).
#   - crates/tasty-doc-guards/src/bin/* : 게이트 스크립트가 부르는 CLI 판정기. 이 크레이트는
#                                       의존이 0 인 것이 존재 이유라(ADR-0138) tracing 을
#                                       들일 수 없고, 진단은 stdout/stderr 가 인터페이스다.
#                                       (`src/` 의 나머지는 예외가 아니다 — 라이브러리는
#                                       아무것도 출력하지 않는다)
#   - crates/tasty-doc-guards/tests/* : 같은 크레이트의 통합 테스트 타깃 — 출하 바이너리에
#                                       없으니 위 규칙의 술어("라이브러리는 아무것도
#                                       출력하지 않는다")가 애초에 안 닿는다. tracing 을
#                                       못 들이는 것은 **크레이트 속성**이라 bins 와 같은
#                                       사유가 글자 그대로 성립한다. 여기서 찍는 것은
#                                       가드가 센 **모수**이고, 그것이 없으면 하한 단정만
#                                       남아 "0" 이 안 봐서 0 인지 정말 없어서 0 인지가
#                                       안 갈린다. bins 만 면제하고 tests 를 뺀 것은 의도가
#                                       아니라 누락이었다.
# 그 외 .rs 파일은 tracing::info!/warn!/error! 사용.
check_println() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        case "$f" in
            src/main.rs) continue ;;
            src/boot/cli_routing.rs) continue ;;
            crates/tasty-cli/*) continue ;;
            crates/tasty-tui-simulator/*) continue ;;
            site/*) continue ;;
            build.rs) continue ;;
            */build.rs) continue ;;
            crates/tasty-latency-control/*) continue ;;
            src/source_guards/*) continue ;;
            crates/tasty-doc-guards/src/bin/*) continue ;;
            crates/tasty-doc-guards/tests/*) continue ;;
        esac
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E '\b(println|eprintln)!' \
            | grep -vE '^\+[[:space:]]*//' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.11 println] $f — \`tracing::info!\` / \`tracing::warn!\` 등 사용:"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# C.12 dbg! 매크로 (debug leak 방지)
# ────────────────────────────────────────────────────────────
# staged diff 의 추가 line 만 검사.
check_dbg() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        local violation
        violation=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -v '^+++' \
            | grep -E '\bdbg!' \
            | grep -vE '^\+[[:space:]]*//' \
            || true)
        if [ -n "$violation" ]; then
            fail "[C.12 dbg!] $f — \`dbg!\` 매크로 추가됨 (release 에 leak 금지):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

# ────────────────────────────────────────────────────────────
# W.1  사용자 표면 변경 시 CHANGELOG 누락 (경고만, 커밋은 통과)
# ────────────────────────────────────────────────────────────
# CHANGELOG.md 는 "사용자가 의존하는 표면" 의 변경을 기록한다(CHANGELOG.md 머리말).
# 그 표면이 선언되는 파일이 staged 인데 CHANGELOG.md 는 staged 가 아니면 상기시킨다.
#   - crates/tasty-ipc/src/method_meta.rs   : IPC 메서드 표
#   - crates/tasty-cli/src/commands/        : CLI 서브커맨드
#   - crates/tasty-plugin-*/tasty-plugin.toml : plugin 매니페스트(권한·인자)
# **경고만 한다** — 그 파일을 만졌다고 반드시 표면이 바뀌는 것은 아니다(내부 refactor,
# 오타 수정, 버전 bump 만인 매니페스트). 하드 실패로 만들면 무해한 커밋마다
# --no-verify 를 쓰게 되고 훅 전체가 무력화된다. 판단은 사람이 한다.
check_changelog_reminder() {
    local staged surface
    staged=$(git diff --cached --name-only --diff-filter=ACMR)
    if grep -qx 'CHANGELOG.md' <<<"$staged"; then return; fi
    surface=$(echo "$staged" | grep -E \
        -e '^crates/tasty-ipc/src/method_meta\.rs$' \
        -e '^crates/tasty-cli/src/commands/' \
        -e '^crates/tasty-plugin-[^/]+/tasty-plugin\.toml$' \
        || true)
    if [ -z "$surface" ]; then return; fi
    yellow "▸ [W.1] 사용자 표면 선언 파일이 staged 인데 CHANGELOG.md 는 아니다:"
    echo "$surface" | sed 's/^/      /' >&2
    yellow "  표면이 실제로 바뀌었으면 CHANGELOG.md \`[Unreleased]\` 에 넣어라"
    yellow "  (내부 refactor·버전 bump 뿐이면 무시해도 된다 — 경고일 뿐 커밋은 진행된다)."
}

# ────────────────────────────────────────────────────────────
# W.2  새 파일이 추가됐을 때 그것을 처음 보는 타깃 안내 (경고만)
#
# 새로 만든 것을 판정하는 타깃이 **다른 패키지에 있어서** 놓치는 일이 반복됐다.
# `cargo test -p <크레이트>` 는 루트 패키지의 통합 타깃을 안 돌리고, 그 반대도
# 마찬가지다. 판정자는 있었고 자동 채널도 있었는데 커밋하는 사람이 안 돌렸다.
#
# 정확한 매핑("이 파일을 무엇이 판정하는가")은 순회 범위를 소스에서 읽어야 하고
# 그것은 임의의 코드라 근사밖에 안 된다. 그래서 여기서는 **새것의 종류**로만
# 안내한다 — 종류는 경로 모양으로 정해지므로 근사가 아니다.
#
# 경고일 뿐이라 목록이 낡아도 커밋을 막지 않는다. 다만 낡은 안내는 죽은 인용이
# 되므로, 안내하기 전에 그 타깃 파일이 실재하는지 확인하고 없으면 그렇게 말한다.
# ────────────────────────────────────────────────────────────
suggest_target() {
    # $1 = 타깃 소스 경로, $2 = 돌리는 명령, $3 = 왜 이것이 먼저 보는가
    if [ -f "$1" ]; then
        yellow "      $2"
        yellow "        ↳ $3"
    else
        yellow "      (안내가 낡았다: $1 가 없다 — 이 훅의 W.2 목록을 고쳐라)"
    fi
}

# 알려진 종류의 경로 모양. **분류와 미분류가 같은 목록을 봐야** 둘이 갈리지 않는다 —
# 목록이 둘이면 하나만 움직이고, 움직이지 않은 쪽이 조용해진다.
KNOWN_KIND_RE='^(tests/[^/]+\.rs|crates/[^/]+/tests/[^/]+\.rs|crates/[^/]+/Cargo\.toml|src/.*\.rs|crates/[^/]+/src/.*\.rs|docs/.*\.md|scripts/.*\.sh|\.githooks/[^/]+|site/.*)$'

check_new_file_judges() {
    local added new_int_test new_crate new_src new_doc new_shell new_site unknown
    added=$(git diff --cached --name-only --diff-filter=A || true)
    if [ -z "$added" ]; then return; fi

    new_int_test=$(echo "$added" | /usr/bin/grep -E '^(tests/[^/]+\.rs|crates/[^/]+/tests/[^/]+\.rs)$' || true)
    new_crate=$(echo "$added" | /usr/bin/grep -E '^crates/[^/]+/Cargo\.toml$' || true)
    new_src=$(echo "$added" | /usr/bin/grep -E '^(src/|crates/[^/]+/src/).*\.rs$' || true)
    new_doc=$(echo "$added" | /usr/bin/grep -E '^docs/.*\.md$' || true)
    new_shell=$(echo "$added" | /usr/bin/grep -E '^(scripts/.*\.sh|\.githooks/[^/]+)$' || true)
    new_site=$(echo "$added" | /usr/bin/grep -E '^site/' || true)
    unknown=$(echo "$added" | /usr/bin/grep -vE "$KNOWN_KIND_RE" || true)

    if [ -z "$new_int_test$new_crate$new_src$new_doc$new_shell$new_site$unknown" ]; then return; fi

    yellow "▸ [W.2] 새 파일이 추가됐다. 그것을 처음 보는 타깃은 이 커밋을 만든 명령에"
    yellow "  안 들어갔을 수 있다 (-p <크레이트> 는 루트 패키지 타깃을 안 돌린다)."

    if [ -n "$new_int_test" ]; then
        yellow "  새 통합 테스트 타깃:"
        echo "$new_int_test" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/let_underscore_documented.rs" \
            "cargo test --locked -p tasty-doc-guards --test let_underscore_documented" \
            "테스트 타깃이 프로덕션 lint 명부에 섞이는 것을 여기서 처음 본다 (파일 머리 allow 한 줄이 필요하다)"
        # ★ 위 머리말이 말한 그 함정이 **이 갈래에서** 난다. `crates/*/tests/` 에 새 파일을
        #   만든 사람은 그 크레이트를 `-p` 로 돌려 초록을 보고 끝낸다. 그런데 그 파일을
        #   판정하는 가드 일부는 루트 패키지 **라이브러리 안**(src/source_guards/)에 살고,
        #   `-p <크레이트>` 도 셸 게이트도 그 타깃에 닿지 않는다. 실측 2026-09-08:
        #   새 통합 타깃 하나가 -p tasty-doc-guards 533 passed · 셸 게이트 6 종 전부 초록인
        #   채로 repo_relative_paths 가드에 빨갛게 잡혔다 — 같은 형태가 하루에 세 번 났다.
        suggest_target "src/source_guards/repo_relative_paths.rs" \
            "cargo test --locked -p tasty --lib" \
            "루트 패키지 라이브러리 안(src/source_guards/)에 사는 가드들이 이 파일을 여기서 처음 본다 — 바로 위 -p tasty-doc-guards 는 그 타깃에 안 닿는다"
    fi
    if [ -n "$new_crate" ]; then
        yellow "  새 크레이트:"
        echo "$new_crate" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/architecture_crate_list_complete.rs" \
            "cargo test --locked -p tasty-doc-guards --test architecture_crate_list_complete" \
            "크레이트 명부와 문서의 정합을 여기서 처음 본다"
        yellow "      cargo deny check licenses"
        yellow "        ↳ license 필드가 없으면 여기서만 걸린다 (로컬에 있는데 안 부르면 CI 에서 처음 본다)"
    fi
    if [ -n "$new_src" ]; then
        yellow "  새 소스 파일:"
        echo "$new_src" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/no_emoji_in_source.rs" \
            "cargo test --locked -p tasty-doc-guards --test no_emoji_in_source --test no_hardcoded_ui_strings" \
            "새 소스의 이모지·하드코딩 문자열을 여기서 처음 본다"
    fi
    if [ -n "$new_doc" ]; then
        yellow "  새 문서:"
        echo "$new_doc" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/no_checkbox_in_docs.rs" \
            "cargo test --locked -p tasty-doc-guards" \
            "체크박스·표 정합·인용 좌표를 이 크레이트가 처음 본다"
    fi
    if [ -n "$new_shell" ]; then
        yellow "  새 셸 스크립트:"
        echo "$new_shell" | sed 's/^/      /' >&2
        suggest_target "crates/tasty-doc-guards/tests/no_early_exit_consumer_in_shell_pipes.rs" \
            "cargo test --locked -p tasty-doc-guards --test no_early_exit_consumer_in_shell_pipes" \
            "셸은 루트의 통합 타깃이 본다 — 그 타깃은 확장자가 아니라 shebang 으로 고르므로 확장자 없는 훅도 대상이다"
    fi
    if [ -n "$new_site" ]; then
        yellow "  새 사이트 파일:"
        echo "$new_site" | sed 's/^/      /' >&2
        # ★ 이 갈래는 **cargo 타깃을 안 댄다** — 대 줄 것이 없기 때문이다. `site/` 는
        #   Rust 가 아니라 Astro 앱이고, `site/src/` 아래를 순회하는 가드는 레포에 하나도
        #   없다(실측). 그래서 여기 적는 것은 "무엇이 이것을 처음 보는가" 의 사실대로
        #   npm 쪽 명령이다. 이 갈래가 없던 동안 `site/` 의 새 파일은 "종류를 모르는
        #   파일" 로 나갔는데, 종류는 알려져 있고 채널도 있다 — 없는 것은 **cargo 채널**뿐이다.
        yellow "      (cd site && npm run build)"
        yellow "        ↳ Astro 빌드가 임포트·문법을 여기서 처음 본다. 자동 채널은 pages.yml (main push · site/** 등)"
        yellow "      (cd site && npm run check-links)"
        yellow "        ↳ site/content/ 의 링크를 본다 — 컴포넌트·스타일은 그 대상이 아니다"
        yellow "        ↳ ★ site/src/ 아래를 순회하는 러스트 가드는 없다 — 토큰·raw px 류는 아무도 안 본다"
    fi
    if [ -n "$unknown" ]; then
        yellow "  ▸ 이 훅이 **종류를 모르는** 새 파일:"
        echo "$unknown" | sed 's/^/      /' >&2
        yellow "        ↳ 위 목록에 행이 없는 경로 모양이다. 이것을 보는 타깃이 있는지"
        yellow "          확인하고, 있으면 이 훅에 행을 더해라. 자산 파일이면 무시해도 된다."
    fi
    yellow "  (경고일 뿐 커밋은 진행된다 — 이미 돌렸으면 무시해라.)"
}

# ────────────────────────────────────────────────────────────
# P.1  plugin 산출물이 바뀌었는데 매니페스트 version 이 그대로
#
# 판정은 scripts/check-plugin-version-bump.sh 하나가 한다 — 훅과 CI 가 같은 것을
# 불러야 둘이 갈리지 않는다. 판별식(파일 수 문턱이 아니라 rustfmt 정규화 후 내용)의
# 근거·측정·대안은 docs/adr/0137-plugin-version-bump-is-judged-by-content-not-file-count.md.
#
# **비교 기준은 HEAD 가 아니라 main 과의 merge-base 다.** HEAD 와 비교하면 `--amend`
# 로 고쳐 커밋할 때 "이미 올린 그 커밋" 이 기준이 되어 두 번째 bump 를 요구하게 된다.
# merge-base 기준이면 "이 lane 이 main 대비 한 번 올렸는가" 를 묻게 되어 amend·rebase
# 어느 쪽에도 흔들리지 않고, 목적(반영 시점에 올라 있는가)과도 일치한다.
# main 이 없거나(단독 clone) merge-base 를 못 구하면 HEAD 로 떨어진다.
# ────────────────────────────────────────────────────────────
#
# **선필터는 `^crates/` 다 — plugin 디렉토리가 아니다.** 판정 대상은 plugin 디렉토리가
# 아니라 워크스페이스 내부 의존 폐포이므로(ADR-0166), 이름이 `tasty-plugin-` 으로
# 시작하지 않는 크레이트(`tasty-utils`·`tasty-shm` 등)만 담은 커밋도 9 개 전부의 bump 를
# 요구할 수 있다. 좁은 필터는 그런 커밋에서 스크립트를 **부르지도 않아** 초록이 된다 —
# 실측으로 그 형태가 났다(`crates/tasty-utils/src/notify.rs` 한 파일만 담은 커밋에서
# 선필터 0 건, 같은 내용에 스크립트를 직접 돌리면 위반 9 / 대상 9). 같은 스크립트를 부르는
# 다른 두 자리(pre-push B.9 · plugin-version-check.yml)는 이미 넓고, 로컬 훅만 좁게
# 남아 있었다.
# ────────────────────────────────────────────────────────────
check_plugin_version_bump() {
    local staged_plugin base rc
    staged_plugin=$(git diff --cached --name-only --diff-filter=ACMRD \
        | /usr/bin/grep -E '^crates/' || true)
    if [ -z "$staged_plugin" ]; then return; fi

    base=$(git merge-base main HEAD 2>/dev/null || true)
    [ -n "$base" ] || base=HEAD

    set +e
    bash scripts/check-plugin-version-bump.sh --staged --base "$base"
    rc=$?
    set -e
    case "$rc" in
        0) ;;
        1) red "▸ [P.1] plugin 산출물이 바뀌었는데 매니페스트 version 이 그대로다 (위 목록)."
           FAIL=1 ;;
        *) # **판정 불가를 통과로 세지 않는다.** 이유는 스크립트가 이미 출력했다.
           red "▸ [P.1] 판정 불가 (exit $rc) — 위 사유를 해소하거나 --no-verify 로 우회해라."
           FAIL=1 ;;
    esac
}

# ────────────────────────────────────────────────────────────
# T.1  커밋되지 않는 티켓을 가리키는 인용 — `no_todo_file_citation` 가드.
#
# **이 검사만 staged diff 가 아니라 레포 전체 작업 트리를 본다.** 그 가드의 좌변이
# 순회라 그렇다(위 ⑦ 축). 그래서 내가 안 건드린 파일이 범인일 수 있고, 그것이
# 이 선택의 내용이다 — staged 밖에 남은 죽은 인용도 같이 막는다.
#
# **여기 둘 만큼 싸다.** 실측 2.0 s 이고, 무관한 소스를 `touch` 한 뒤에도 같다 —
# `tasty-doc-guards` 는 의존이 0 이라(ADR-0138) 워크스페이스가 바뀌어도 재빌드하지
# 않는다. 머리말의 "무거운 검사는 pre-push 에서" 가 겨냥하는 것은 워크스페이스를
# 컴파일하는 clippy/check 이고, 이 검사는 그 선 아래다.
#
# **pre-push `B.7`(`cargo test -p tasty-doc-guards`)과 겹치는 것은 의도다.** 두 훅은
# 서로 다른 자리를 막는다 — 여기는 커밋이 만들어지는 것을, 거기는 push 되는 것을.
# 겹친다고 한쪽을 지우면 그 자리의 채널이 사라진다(rebase 로 남의 위반이 들어온
# 트리에서는 pre-commit 만이 그 자리에서 답한다).
# ────────────────────────────────────────────────────────────
check_todo_citation() {
    local out rc
    # **파이프로 `tail` 에 바로 넘기지 않는다.** 그러면 rc 가 `tail` 의 것이 되어
    # 위반이 있어도 0 이 돌아온다 — 잡으라고 둔 검사가 조용히 통과한다.
    set +e
    out=$(cargo test -q -p tasty-doc-guards --test no_todo_file_citation 2>&1)
    rc=$?
    set -e
    if [ "$rc" -ne 0 ]; then
        printf '%s\n' "$out" | tail -40 >&2
        red "▸ [T.1] 커밋되지 않는 로컬 티켓·문서를 가리키는 인용이 있다 (위 목록)."
        red "    이 가드는 **레포 전체**를 본다 — staged 밖 파일이 범인일 수 있다."
        FAIL=1
    fi
}

# ────────────────────────────────────────────────────────────
# 실행
# ────────────────────────────────────────────────────────────
# 검사 목록을 **배열**로 둔다. 문자열 하나에 담아 셸 분할에 맡기면, 부르는 셸이 달라질 때
# 루프가 **조용히 0 회** 돌 수 있다(조립 하네스에서 실제로 났다: zsh 전용 `${=VAR}` 분할을
# bash 로 부르자 게이트 루프가 0 회 돌고 판정줄은 "게이트빨강=0" 으로 찍혔다 —
# **안 돈 것이 다 통과한 것과 같은 모양이었다**).
CHECKS=(
    check_mod_use_order
    check_cargo_fmt
    check_shell_assets
    check_let_underscore
    check_color_hardcode
    check_egui_window
    check_println
    check_dbg
    check_plugin_version_bump
    check_todo_citation
    check_changelog_reminder
    check_new_file_judges
)

# 그리고 **정의된 것과 부르는 것이 같은가**를 훅이 자기에게 묻는다.
#
# 새 `check_*` 를 정의하고 위 배열에 안 넣으면, 지금까지는 훅이 **초록이었고 통과줄이 글자
# 하나 안 달라졌다.** 그 상태와 "그 검사가 다 통과했다" 가 출력으로 구분이 안 된다.
# 여기서 세어 두면 어긋남이 그 자리에서 빨개진다. 값이 아니라 **판정의 일부**다.
defined=$(grep -cE '^check_[a-z_]+\(\) \{' "$0" || true)

# ★ 붕괴를 먼저 막는다. 아래 등호 검사만으로는 **0 == 0 이 통과한다** — 배열이 비고
# 세는 술어도 안 맞으면 "검사 0/0 돌았다" 를 찍고 rc=0 이 된다. 실측으로 재현했다.
# 그 초록은 "다 통과했다" 가 아니라 **"아무것도 안 봤다"** 이고, 둘은 출력이 같다.
# (조립 하네스의 `${=GATES}` 가 정확히 이 모양이었다. 등호만 걸면 그 교훈의 절반만 든다.)
#
# 하한을 실측값(예: 10)으로 두지 않는다 — 아래 등호가 이미 수를 정확히 못 박으므로,
# 여기 또 수를 두면 **같은 물음에 답이 둘**이 되고 검사를 더할 때마다 둘 다 고쳐야 한다.
# 이 조건의 일은 붕괴를 거절하는 것 하나다.
if [ "${#CHECKS[@]}" -eq 0 ] || [ "$defined" -eq 0 ]; then
    red "▸ [훅] 검사가 0 개다 (정의 $defined · 실행 목록 ${#CHECKS[@]}) — **아무것도 안 돌았다.**"
    red "    배열이 비었거나, 정의를 세는 술어가 함수 선언 모양과 안 맞는다."
    red "    이 상태에서 초록을 내면 '안 봤다' 가 '다 통과했다' 로 찍힌다."
    exit 1
fi

if [ "$defined" -ne "${#CHECKS[@]}" ]; then
    red "▸ [훅] 정의된 검사 $defined 개 · 실행 목록 ${#CHECKS[@]} 개 — 어긋난다."
    if [ "$defined" -gt "${#CHECKS[@]}" ]; then
        red "    정의만 있고 목록에 없는 것이 있다 — 그 검사는 **조용히 안 돈다.** CHECKS 에 넣어라."
    else
        red "    목록에만 있고 정의가 없는 것이 있다 — 이름을 고쳤거나 지웠다. CHECKS 에서 빼라."
    fi
    exit 1
fi

RAN=0
for _check in "${CHECKS[@]}"; do
    "$_check"
    RAN=$((RAN + 1))
done

if [ "$FAIL" -ne 0 ]; then
    echo >&2
    red "✘ pre-commit 검사 실패. 위 항목을 수정하거나 \`git commit --no-verify\` 로 우회."
    exit 1
fi

# ────────────────────────────────────────────────────────────
# 통과 줄에 **모수**를 붙인다.
#
# 이 훅의 각 구역은 자기 모수를 머리 주석에 적어 뒀다(`[파일 전체]` · `[diff 추가 라인]`
# · `[staged]`). 그런데 그 표기는 판정의 **정의** 옆에 있고, 커밋하는 사람이 보는 것은
# 판정의 **출력** — 모수가 없는 한 줄이었다. 그래서 초록이 "staged 범위가 깨끗하다" 가
# 아니라 "트리가 깨끗하다" 로 읽혔다. 실제로 그렇게 읽혀서, 추적 안 되는 쓰레기 파일이
# 훅을 초록으로 통과한 채 남았다(레포 전체를 훑는 doc-guards 가드가 나중에 잡았다).
#
# 값은 **새로 세지 않는다.** 위에서 검사들에게 넘긴 바로 그 목록의 길이를 쓴다 — 여기서
# git 을 다시 부르면 그 계수기가 판정과 다른 모수를 갖게 되고, 그러면 이 줄이 고치려던
# 병을 이 줄이 다시 만든다.
#
# ★ P.1 · W.1 은 아래 수보다 **넓게** 본다(이름 바뀜 · 지움까지). 전에는 "안 가진 값을
# 찍느니 안 찍는 것이 낫다" 고 적고 대신 "ACM 기준" 이라는 필터 문자를 달았다. 둘 다 틀렸다 —
# 그 값은 git 한 번으로 가질 수 있고, 필터 문자는 뜻을 옮기지 않는다. 넓은 쪽이 **더 본 것이
# 있을 때만** 아래에 한 줄 더 찍는다. 늘 찍으면 문장이 안 변해 다시 벽지가 된다.
# ────────────────────────────────────────────────────────────
count() { [ -z "$1" ] && echo 0 || printf '%s\n' "$1" | wc -l | tr -d ' '; }

green "✓ pre-commit 검사 통과 (검사 $RAN/$defined 돌았다 · 모수: staged .rs $(count "$STAGED_RS") · staged 전체 $(count "$STAGED_ALL") — 더해지거나 고쳐지거나 이름이 바뀐 것)"

# 넓은 쪽과의 차이. 0 이면 안 찍는다 — 이 줄이 **상황에 반응해야** 뜻이 산다.
STAGED_WIDE=$(git diff --cached --name-only --diff-filter=ACMRD || true)
wide_extra=$(( $(count "$STAGED_WIDE") - $(count "$STAGED_ALL") ))
if [ "$wide_extra" -gt 0 ]; then
    yellow "  ↳ 지워진 것 $wide_extra 개는 **위 수 밖**이다 — 파일을 여는 검사는 그것을 못 본다. P.1 이 본다."
fi

# 그리고 **여집합**을 한 줄 더 찍는다 — 있을 때만.
#
# 위 수만으로는 부족했다(실측): 추적 안 되는 쓰레기 파일을 놓아도 통과 줄이 **글자 하나
# 안 바뀐다.** 범위를 말해 주기는 하지만 그 문장이 늘 같아서 벽지가 된다. 초록을 "트리가
# 깨끗하다" 로 읽는 것을 막으려면 출력이 **그 상황에 반응**해야 한다.
#
# ★ 이 수는 **어느 검사의 모수도 아니다.** 모든 모수의 **밖**이다 — 그래서 위의 수들과
#   달라도 어긋난 것이 아니다. 라벨에 그 사실을 적는다.
untracked=$(git status --porcelain --untracked-files=normal 2>/dev/null | grep -c '^??' || true)
if [ "$untracked" -gt 0 ]; then
    yellow "  ↳ 추적 안 되는 파일 $untracked 개는 **위 모수 밖**이다 — 이 초록이 말하지 않는 것이다."
    yellow "     의도한 것이 아니면 \`git status --porcelain\` 로 봐라. 트리 전체는 \`cargo test -p tasty-doc-guards\`."
fi
exit 0
