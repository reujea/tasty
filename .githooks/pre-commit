#!/usr/bin/env bash
# Tasty pre-commit hook.
#
# **여기에 검사 개수를 적지 않는다.** 한때 "빠른 검사 7종" 이라 적혀 있었고 실제로는
# 열이었다 — 적힌 수는 검사를 더할 때 같이 안 움직인다. 수는 **돌 때 찍는다**(맨 아래
# 통과줄). 목록은 아래 표가 정본이고, 표와 실제 호출이 어긋나면 훅이 스스로 실패한다.
#
# 설치: `git config core.hooksPath .githooks` 1회 실행.
# bypass: `git commit --no-verify` (긴급 시).
#
# 정책: 모든 *diff 기반* 검사 (C.6/C.9/C.11/C.12) 는 **staged diff 의 추가 라인
# (`+`) 만** 본다. 기존 코드의 위반은 잡지 않는다 — 신규 추가에만 적용
# (changed-only policy). A.1/A.2 만 *파일 전체* 검사 (포맷·선언 순서는 컨텍스트
# 전체가 필요).
#
# 검사 목록:
#   A.1  mod/use 선언 순서 (mod 다 먼저, use 다 나중)  [staged .rs 의 파일 전체]
#   A.2  cargo fmt --check (+ workspace exclude 크레이트는 manifest 별도) [staged .rs 의 파일 전체]
#   A.3  셸 자산 정적 검사 (shellcheck, warning 이상)  [staged 중 셸 자산의 파일 전체]
#   C.6  `let _ =` 주석 강제                            [추가된 줄 + **바로 윗줄**]
#   C.8  UI 색상 하드코딩 — clippy 로 이관 (비활성)
#   C.9  egui::Window 직접 사용                          [추가된 줄만]
#   C.11 println! / eprintln! — tracing 강제             [추가된 줄만]
#   C.12 dbg! — debug leak 방지                          [추가된 줄만]
#   P.1  plugin 산출물이 바뀌었는데 매니페스트 version 이 그대로 [파일 목록 — **지운 것까지**]
#   T.1  커밋되지 않는 티켓을 가리키는 인용 (P1~P7)      [레포 전체 작업 트리]
#   W.1  사용자 표면 변경 시 CHANGELOG 누락 (경고만)     [파일 목록 — **이름만 바뀐 것도**, 지운 것은 빼고]
#   W.2  새 파일이 추가됐을 때 그것을 처음 보는 타깃 안내 (경고만) [파일 목록 — **새로 더한 것만**]
#
# ★ 대괄호는 **그 검사가 무엇을 보는가**다. 여섯 가지고, 서로 겹치지 않는다:
#     ① staged .rs 의 파일 전체            A.1 · A.2   (A.3 은 staged 셸 자산)
#     ② 추가된 줄만                        C.9 · C.11 · C.12
#     ③ 추가된 줄 + 바로 윗줄              C.6   ← **안 고친 주석도 본다**
#     ④ 파일 목록 — 새로 더한 것만         W.2
#     ⑤ 파일 목록 — 이름 바뀜까지          W.1
#     ⑥ 파일 목록 — 지운 것까지            P.1
#     ⑦ 레포 전체 작업 트리                 T.1   ← **staged 밖도 본다**
#   ⑦ 은 위 여섯과 성질이 다르다. 나머지는 전부 "이 커밋이 무엇을 더했나" 를 묻고
#   changed-only 정책을 따르는데, T.1 이 부르는 가드는 순회가 좌변이라 **레포 전체**를
#   본다. 그 성질을 라벨에 적어 두는 이유는, 이 검사가 빨개졌을 때 **내가 안 건드린
#   파일이 범인일 수 있다**는 것을 읽는 사람이 알아야 하기 때문이다. 얻는 것은 그
#   대가에 값한다 — staged 밖에 남아 있던 죽은 인용도 같이 막히고, 무엇보다 rebase 로
#   남의 위반이 내 트리에 들어온 상태가 push 까지 가지 않는다.
#   한때 이 자리에 `[파일 전체]`·`[diff 추가 라인]`·`[staged 파일 목록]` 셋만 있었다.
#   ④⑤⑥ 이 **한 라벨을 나눠 쓰고 있었고**, 그래서 "이 훅이 무엇을 봤나" 를 라벨로 물으면
#   셋이 하나로 보였다. 라벨에 필터 문자(ACM 류)를 박는 대신 **무엇이 달라지는지**를 적는다 —
#   필터 문자는 읽는 사람이 git 문서를 한 번 더 봐야 뜻이 서고, 그 사이 뜻이 사라진다.
#
# 무거운 검사 (cargo clippy, cargo check) 는 pre-push 에서. T.1 은 그 선을 안 넘는다 —
# 실측 2.0 s 로, 워크스페이스를 컴파일하는 clippy/check 와 두 자릿수 배 차이다.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# staged 된 파일 목록. `.rs` 목록은 여기서 갈라 낸다 — 두 값이 **같은 한 번의 조회**에서
# 나와야 아래 통과 줄이 찍는 모수가 검사들이 실제로 순회한 것과 같다.
#
# ★ **`R`(이름 바뀜)이 들어가야 한다.** 없으면 **순수 rename 커밋의 모수가 0 이 되고**,
#   이 값에서 조기 return 하는 검사 여섯(A.1 mod/use 순서 · A.2 `cargo fmt` · C.6 `let _`
#   사유 · C.9 `egui::Window` · C.11 · C.12)이 **한 줄도 안 보고 초록을 낸다**(실측: 옮기기만
#   한 커밋에서 `staged .rs 0 · staged 전체 0` 이 찍혔다). 옮긴 파일은 내용이 같아도 **자리가
#   달라진다** — mod/use 순서와 크레이트 귀속은 자리가 정한다.
# ★ **`D`(지움)는 일부러 뺀다.** 위 검사들은 전부 **파일을 연다** — 지워진 경로를 열면 없는
#   파일이고, 그것을 실패로 셀지 통과로 셀지가 또 갈린다. 지움을 봐야 하는 것은 파일을 안
#   여는 검사들(P.1·W.1)이고 그쪽은 자기 자리에서 `ACMRD`·`ACMR` 로 따로 묻는다.
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACMR || true)
STAGED_RS=$(printf '%s\n' "$STAGED_ALL" | grep -E '\.rs$' || true)

red()    { printf '\033[31m%s\033[0m\n' "$*" >&2; }
yellow() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
green()  { printf '\033[32m%s\033[0m\n' "$*"; }

# ────────────────────────────────────────────────────────────
# M.1  merge 커밋 차단 — branch 가 갈라지는 2-parent 머지 커밋 금지.
#      pre-merge-commit 은 clean non-ff merge 만 잡는다. **충돌 merge** 는
#      git merge 가 커밋을 안 만들고 멈춘 뒤 resolve → `git commit` 으로
#      마무리되며, 그 커밋은 pre-merge-commit 이 아니라 이 훅을 탄다.
#      여기서 잡지 않으면 충돌 merge 가 갈래 커밋으로 새어 들어온다.
#      정책: 모든 통합은 rebase → ff-merge 로 선형 유지. rebase 로 다 된다.
# ────────────────────────────────────────────────────────────
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    red "✘ branch 가 갈라지는 merge 커밋이 차단되었습니다 (2-parent)."
    echo
    yellow "▸ 정책: 모든 통합은 rebase 로 선형화한다. 충돌이 있어도 rebase 로 해결된다 —"
    yellow "  merge 커밋(갈래)은 만들지 않는다."
    echo
    yellow "▸ 지금 이 merge 를 되돌리고 rebase 로 재시도하라:"
    yellow "    git merge --abort"
    yellow "    git rebase <대상-브랜치>       # 충돌나면 양쪽 의도를 확인 후 해결"
    yellow "    git merge --ff-only <브랜치>"
    echo
    yellow "▸ 충돌은 '마커만 지워서' 해결하지 마라 — 양쪽 변경의 의도를 파악하고"
    yellow "  맞는 결과로 합쳐라. 애매하면 rebase --abort 후 원인부터 분석하라."
    echo
    exit 1
fi

FAIL=0
fail() { red "  ✘ $*"; FAIL=1; }

# ────────────────────────────────────────────────────────────
# A.1  mod/use 선언 순서
# ────────────────────────────────────────────────────────────
check_mod_use_order() {
    if [ -z "$STAGED_RS" ]; then return; fi
    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        # 상류 크레이트 사본은 상류의 선언 순서를 그대로 둔다 — 무엇이 tasty 패치인지가
        # 상류와의 차이로 읽혀야 한다(docs/adr/0516-the-webhook-413-closes-the-connection-through-a-vendored-tiny-http-patch.md).
        case "$f" in vendor/*) continue ;; esac
        # top-level "선언 영역" 안에서만 검사. 영역 = 빈 줄/주석/attribute/use/mod/
        # extern crate 만 나오는 동안. 첫 코드 토큰 (fn/struct/impl/const/static/
        # type/trait/enum/macro_rules) 이 나오면 영역 종료 — dispatcher 패턴
        # (use → fn → 하단 mod tests) 은 정당하므로 통과.
        local violation
        violation=$(awk '
            /^[[:space:]]/ { next }
            /^\/\// { next }
            /^$/ { next }
            /^#\[/ { next }
            /^#!\[/ { next }
            /^(pub(\([^)]*\))?[[:space:]]+)?use[[:space:]]/ { if (!end_zone) saw_use = NR; next }
            /^(pub(\([^)]*\))?[[:space:]]+)?extern[[:space:]]+crate[[:space:]]/ { next }
            # 선언형 `mod x;` 만 검사 대상이다. 인라인 `mod x { ... }` 는 선언이
            # 아니라 **코드**라서 fn/struct 와 같이 영역을 끝낸다 — 그렇게 안 가르면
            # `use` 뒤의 `#[cfg(unix)] mod unix { ... }`(테스트 파일의 흔한 형태)가
            # 오탐으로 걸려, 그 파일을 건드리는 커밋이 전부 막힌다.
            /^(pub(\([^)]*\))?[[:space:]]+)?mod[[:space:]]/ {
                if ($0 !~ /;[[:space:]]*$/) { end_zone = 1; next }
                if (saw_use && !end_zone) { print NR; exit }
                next
            }
            { end_zone = 1 }
        ' "$f")
        if [ -n "$violation" ]; then
            fail "[A.1 mod/use 순서] $f:$violation — 선언 영역에서 mod 가 use 뒤에 나옴"
        fi
    done
}

# ────────────────────────────────────────────────────────────
# A.2  cargo fmt --check
# ────────────────────────────────────────────────────────────
# 루트 `cargo fmt` 는 workspace `exclude` 크레이트(site/, crates/tasty-plugin-sdk-wasm/)
# 를 보지 않는다 — 그 디렉토리의 .rs 가 staged 됐을 때만 manifest 를 따로 지정해
# 검사한다 (docs/dev-guide/site.md "왜 workspace 밖인가"). CI 에도 같은 게이트가
# 있다(.github/workflows/format-check.yml, main push + PR) — 이 훅은 그것을 커밋
# 시점으로 당겨 빠른 피드백을 주는 역할이고, 우회(`--no-verify`)해도 CI 가 잡는다.
EXCLUDED_CRATES="site crates/tasty-plugin-sdk-wasm"

check_cargo_fmt() {
    if [ -z "$STAGED_RS" ]; then return; fi
    if ! cargo fmt --check 2>/dev/null; then
        fail "[A.2 cargo fmt] 포맷 위반. \`cargo fmt\` 실행 후 다시 staging."
    fi
    for crate in $EXCLUDED_CRATES; do
        if grep -q "^$crate/" <<<"$STAGED_RS"; then
            if ! cargo fmt --check --manifest-path "$crate/Cargo.toml" 2>/dev/null; then
                fail "[A.2 cargo fmt] $crate/ 포맷 위반 (workspace exclude — 루트 cargo fmt 미검사). \`cargo fmt --manifest-path $crate/Cargo.toml\` 실행 후 다시 staging."
            fi
        fi
    done
}

# ────────────────────────────────────────────────────────────
# A.3  셸 자산 정적 검사
# ────────────────────────────────────────────────────────────
# 판정은 scripts/check-shell-assets.sh 하나가 한다 — 훅과 CI 가 같은 것을 불러야
# 둘이 갈리지 않는다. 모수만 다르다: 여기서는 **staged 된 셸 자산**을, CI 는 추적되는
# 자산 전부를 본다. 새 파일은 아직 추적 밖이라 전수 모수에 안 들어오므로, 커밋 시점에
# 경로를 직접 넘기는 이 자리가 새 자산을 처음 보는 자리다.
#
# 검사기가 없으면 rc 2 로 멈춘다 — 통과가 아니다. 받는 법은 실패문이 찍는다.
# ────────────────────────────────────────────────────────────
check_shell_assets() {
    local rc
    if [ -z "$STAGED_ALL" ]; then return; fi

    # **무엇이 셸 자산인가는 여기서 안 고른다.** 그 규칙은 게이트 안에 하나뿐이고
    # (`is_shell_asset` — 확장자와 shebang 의 합집합), 여기서 한 번 더 쓰면 같은 물음에
    # 답이 둘이 된다. staged 목록을 그대로 넘기고 거르는 것은 게이트가 한다.
    set +e
    # 단어 분리가 목적이다 — 경로 목록을 가변 인자로 넘긴다.
    # shellcheck disable=SC2086
    bash scripts/check-shell-assets.sh $STAGED_ALL
    rc=$?
    set -e
    case "$rc" in
        0) ;;
        1) fail "[A.3 shell-assets] 셸 자산에 정적 검사 위반이 있다 (위 목록)." ;;
        *) fail "[A.3 shell-assets] 판정 불가 (종료코드 $rc) — 통과가 아니다. 위 줄이 받는 법을 찍는다." ;;
    esac
}

# ────────────────────────────────────────────────────────────
# C.6  `let _ =` 주석 강제
# ────────────────────────────────────────────────────────────
# staged diff 의 추가 line 만 검사. "의도 명시" 로 인정하는 조건 (OR):
#   ① 같은 줄에 // 주석이 있음, 또는
#   ② 위쪽 라인이 // 주석 — **빈 줄과 `#[..]` 속성 줄은 건너뛴다**, 또는
#   ③ 바로 다음 라인 (새 파일 기준) 이 // 주석.
# docs/dev-guide/error-handling.md 의 윗줄 주석 관례 + 멀티라인 write! 케이스를
# 인정한다. ③ 은 rustfmt 가 trailing 주석이 달린 긴 라인을 포맷하며 주석을 다음
# 줄로 분리하는 케이스 (`let _ = foo(Bar {` + 다음 줄 `// 이유`) 를 수용한다.
# 주석이 같은 줄·윗줄·다음 줄 어디에도 없는 `let _ =` 는 여전히 거부.
# -U1 로 뒤쪽 라인 컨텍스트를 확보하고, let 후보를 pending 으로 보류했다가 다음
# (새 파일에 존재하는) 라인이 주석인지 보고 판정한다.
#
# -- ② 가 왜 diff 컨텍스트가 아니라 사본을 보나 -------------------------
# 문서 표는 사유 주석과 문장 사이에 **빈 줄과 `#[..]` 속성**이 있어도 인정한다.
# `#[cfg(windows)]` 가 주석과 문장 사이에 오는 것은 러스트 관용이라 실제로 쓰인다
# (실측: 레포에 속성 낀 자리 1, 빈 줄 낀 자리 0 — 2026-09-07).
# 그 자리는 CI(`crates/tasty-doc-guards/tests/let_underscore_documented.rs`)는 받는데 훅만 막았다. 그러면
# 그 줄을 손대는 커밋이 `--no-verify` 로 도망가고, **한 줄 때문에 훅 열 개가 꺼진다.**
# 게이트가 자기를 우회하게 만드는 형태는 그 자체로 결함이라 넓혔다.
#
# 넓히려면 위로 여러 줄을 봐야 하는데 **diff 컨텍스트로는 원리적으로 부족하다** —
# -U<n> 을 아무리 키워도 경계가 생기고, 그 경계 밖은 조용히 위반이 된다. 그래서
# 위쪽 탐색은 **마스킹 사본을 줄 번호로** 읽는다(사본은 이미 만들어 놨다). 경계가 없다.
# 사본이 없는 트리(갓 클론)에서는 바로 윗줄만 보고 물러난다 — **더 많이 잡는 방향**이라
# 조용한 통과를 안 만든다. 물러났다는 것은 아래에서 말한다.
#
# -- 코드인지 문자열인지는 **판정기가 가른다** ---------------------------
# 이 검사의 물음("이 줄의 **코드**에 `let _ =` 가 있나")은 문자열 리터럴을 코드와
# 구분해야 답할 수 있다. 여기서 렉서를 다시 만들지 않는다 -- 러스트 층이 이미 갖고
# 있고(`tasty-doc-guards` 의 `mask-source`), 셸이 자기 것을 만들면 같은 물음에 답이
# 둘이 된다(실제로 그렇게 갈려 있었다).
#
# **줄 번호로 맞춘다.** staged 내용을 마스킹한 사본에서 같은 줄을 읽는다. 그래서
# 여러 줄에 걸친 문자열 리터럴도 옳게 갈린다 -- 한 줄 정규식으로는 원리적으로 못 하던
# 것이고, 가드의 회귀 픽스처가 실제로 그것 때문에 막혀 문구를 바꿔 우회했다.
#
# 판정기가 없으면(갓 클론한 트리) **한 줄 정규식으로 물러난다.** 그쪽은 더 많이 잡는
# 방향이라 조용한 통과를 안 만든다. 물러났다는 것을 말한다.
check_let_underscore() {
    if [ -z "$STAGED_RS" ]; then return; fi

    local mask_bin="" masked="" staged_dir=""
    if [ -r "$REPO_ROOT/scripts/lib/judge-bin.sh" ]; then
        . "$REPO_ROOT/scripts/lib/judge-bin.sh"
        # `resolve_judge` 는 경로를 **`JUDGE_BIN` 변수로** 돌려준다. 표준출력으로 받으면
        # 항상 빈 문자열이라 아래 분기가 늘 정규식 쪽으로 떨어진다 — 그래도 이 게이트는
        # 초록이라(정규식은 더 많이 잡는 방향이다) 격하됐다는 사실이 값으로 안 남는다.
        # 사유는 그 함수 doc 에 있다: 표준출력 반환은 판정기가 한 줄만 찍어도 깨진다.
        resolve_judge mask-source TASTY_MASK_SOURCE_BIN "$REPO_ROOT"
        mask_bin="$JUDGE_BIN"
    fi
    if [ -n "$mask_bin" ]; then
        staged_dir="$(mktemp -d)"
        for f in $STAGED_RS; do
            mkdir -p "$staged_dir/staged/$(dirname "$f")"
            git show ":$f" > "$staged_dir/staged/$f" 2>/dev/null || true
        done
        masked="$(mktemp -d)"
        if "$mask_bin" --keep-comments "$masked" "$staged_dir" staged >/dev/null 2>&1; then
            masked="$masked/staged"
        else
            rm -rf "$masked"; masked=""
        fi
        rm -rf "$staged_dir"
    fi
    if [ -z "$masked" ]; then
        echo "  [C.6] mask-source 가 없거나 낡아 한 줄 정규식으로 판정한다 (여러 줄 문자열 안의 let _ 를 코드로 볼 수 있다). 위 [judge] 줄이 어느 쪽인지 말한다." >&2
    fi

    for f in $STAGED_RS; do
        [ -f "$f" ] || continue
        # 상류 크레이트 사본의 `let _` 은 상류가 쓴 그대로 둔다(A.1 과 같은 이유). 전수
        # 가드 `let_underscore_documented.rs` 는 그 줄들을 줄 단위 ALLOWLIST 로 면제한다.
        case "$f" in vendor/*) continue ;; esac
        local violation masked_file=""
        if [ -n "$masked" ] && [ -f "$masked/$f" ]; then masked_file="$masked/$f"; fi
        violation=$(git diff --cached -U1 -- "$f" | awk -v maskfile="$masked_file" '
            # 마스킹 사본을 줄 번호로 읽어 둔다. 없으면 한 줄 정규식으로 물러난다.
            BEGIN { if (maskfile != "") { while ((getline ml < maskfile) > 0) MASK[++mn] = ml } }
            function flush() { if (pending != "") { print pending; pending = "" } }
            # ② 위쪽 사유 주석 찾기. 빈 줄과 `#[..]` 속성 줄은 건너뛴다(문서 표와 같은 규칙).
            # 사본이 있으면 경계 없이 올라가고, 없으면 바로 윗줄 하나만 보고 물러난다.
            function comment_above(ln,   i, l) {
                if (mn == 0) return (prev ~ /^[[:space:]]*\/\//)
                for (i = ln - 1; i >= 1; i--) {
                    if (!(i in MASK)) return 0
                    l = MASK[i]
                    if (l ~ /^[[:space:]]*$/)    continue
                    if (l ~ /^[[:space:]]*#\[/)  continue
                    return (l ~ /^[[:space:]]*\/\//)
                }
                return 0
            }
            # hunk 경계: 보류 후보 확정 + 컨텍스트 리셋 + **새 파일 줄 번호** 잡기.
            # 줄 번호가 있어야 마스킹 사본의 같은 줄을 읽을 수 있다.
            /^@@/ {
                flush(); prev = ""
                if (match($0, /\+[0-9]+/)) nl = substr($0, RSTART + 1, RLENGTH - 1) - 1
                next
            }
            /^\+\+\+/ { next }              # +++ b/file 헤더
            /^---/    { next }              # --- a/file 헤더
            {
                prefix  = substr($0, 1, 1)
                content = substr($0, 2)
                if (prefix == "-") next     # 제거 라인: 새 파일에 없음 → 무시 (다음 줄 후보 아님)
                if (prefix != "+" && prefix != " ") next
                nl++
                # 판정에 쓰는 사본. 있으면 판정기가 만든 것(문자열·문자 리터럴만 덮고
                # 주석은 남긴다), 없으면 한 줄 정규식으로 물러난다 — 그쪽은 여러 줄에
                # 걸친 문자열을 못 다루고, 그게 이 검사의 알려진 근사였다.
                if (mn > 0 && nl in MASK) { mline = MASK[nl] }
                else { mline = content; gsub(/"([^"\\]|\\.)*"/, "", mline) }
                code = mline; sub(/\/\/.*/, "", code)   # 주석을 뺀 코드 부분
                # 직전 let 후보의 "다음 줄" 이 이 라인. 주석이면 사면, 아니면 위반 확정.
                if (pending != "") {
                    if (mline ~ /^[[:space:]]*\/\//) {
                        pending = ""        # ③ 다음 줄 주석 — OK
                    } else {
                        print pending       # 다음 줄 주석 아님 — 위반 확정
                        pending = ""
                    }
                }
                if (prefix == "+" && code ~ /let[[:space:]]+_[[:space:]]*=/) {
                    if (mline ~ /\/\//) {
                        # ① 같은 줄 주석 — OK
                    } else if (comment_above(nl)) {
                        # ② 위쪽 주석 — OK (빈 줄·속성은 건너뛴다)
                    } else {
                        pending = content   # ③ 판정 보류 — 다음 줄 주석 여부를 봐야 함
                    }
                }
                prev = mline                # 새 파일에 존재하는 라인만 직전으로 갱신
            }
            END { flush() }                 # 마지막 보류 후보 확정
        ')
        if [ -n "$violation" ]; then
            fail "[C.6 let _] $f — 주석 없는 \`let _ =\` 추가됨 (왜 무시하는지 주석 필요):"
            echo "$violation" | sed 's/^/      /' >&2
        fi
    done
}

